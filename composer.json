{
    "name": "paynecta/paynecta-laravel-sdk",
    "description": "Official Laravel SDK for Paynecta Payment API - Simplify M-Pesa, Bank, and Wallet payment integrations in Kenya",
    "keywords": [
        "laravel",
        "paynecta",
        "mpesa",
        "mpesa-integration",
        "payment",
        "payment-gateway",
        "kenya-payments",
        "till",
        "paybill",
        "bank-integration",
        "wallet",
        "sdk",
        "api",
        "kenya"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Paynecta",
            "email": "hello@paynecta.co.ke"
        }
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3",
        "illuminate/support": "^10.0|^11.0",
        "illuminate/http": "^10.0|^11.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Paynecta\\LaravelSdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Paynecta\\LaravelSdk\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Paynecta\\LaravelSdk\\PaynectaServiceProvider"
            ],
            "aliases": {
                "Paynecta": "Paynecta\\LaravelSdk\\Facades\\Paynecta"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}